rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isOwner() { return verified() && myEmail() == 'demajejackson11@gmail.com'; }
    function isStaff() {
      return isOwner() ||
        (verified() && exists(/databases/$(database)/documents/staff/$(myEmail())));
    }

    // One record per student who signs in. Students can only create their own,
    // always as "pending". Only staff can change status.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isStaff()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.email == resource.data.email);
      allow delete: if isStaff();
    }

    // Staff list, keyed by lowercase email. Only the owner can add or remove staff.
    match /staff/{staffEmail} {
      allow read: if isStaff() || (signedIn() && myEmail() == staffEmail);
      allow write: if isOwner();
    }
  }
}
